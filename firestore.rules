rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── helpers ─────────
    function signedIn() { return request.auth != null; }

    // Admin = a signed-in user with a doc at /admins/{their uid} (created by hand in the Console)
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Teacher = a signed-in user with a doc at /teachers/{their uid} (created from Admin > Teachers)
    function isTeacher() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function ownsExisting() { return isTeacher() && resource.data.teacherId == request.auth.uid; }
    function ownsNew()      { return isTeacher() && request.resource.data.teacherId == request.auth.uid; }
    function teacherIdUnchanged() { return request.resource.data.teacherId == resource.data.teacherId; }

    // Student = a signed-in user whose uid is stored as authUid on a students/{id} record
    // (set by the admin when the student's login is created; see studentauth.js).
    function ownsStudent(studentId) {
      return signedIn() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.authUid == request.auth.uid;
    }

    // ───────── identity ─────────
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;             // managed only from the Firebase Console
    }

    match /teachers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ───────── public website ─────────
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if true;                     // the admission form lists classes
      allow write: if isAdmin();
    }

    match /feeSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // publicStats, academic, paymentAccess, resultSettings
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admission form (register.html): anyone can submit; only admin can read or change
    match /applications/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.keys().size() < 150;
      allow read, update, delete: if isAdmin();
    }

    // ───────── students (Firebase Auth, like teachers) ─────────
    // Login address lookup: the student page reads studentLogins/{REGKEY} to learn the private login
    // address for a reg number, then signs in with Firebase Auth. It holds only { email, ver }.
    // Single documents can be read by key; listing is blocked, so reg numbers cannot be enumerated.
    match /studentLogins/{key} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // A student can open ONLY their own record. Admin and teachers can read all (class lists).
    // No password data is stored here any more; Firebase Authentication keeps it.
    match /students/{id} {
      allow get, list: if isAdmin() || isTeacher()
                       || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, delete: if isAdmin();
      // The CBT hall may only update the streak / badge fields, and only on the student's own record
      allow update: if isAdmin()
                    || (signedIn() && resource.data.authUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['totalExams', 'badges']));
    }

    // Report cards: students only ever see published ones
    match /results/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    // Fee payments (written by the student portal after Paystack succeeds)
    match /payments/{id} {
      allow get: if true;
      allow list: if isAdmin() || request.query.limit <= 50;
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.reference is string
                    && request.resource.data.amount is number;
      // setDoc(..., {merge:true}) on a retry is an update: allow it only if the core fields are unchanged
      allow update: if isAdmin()
                    || (request.resource.data.studentId == resource.data.studentId
                        && request.resource.data.reference == resource.data.reference
                        && request.resource.data.amount == resource.data.amount);
      allow delete: if isAdmin();
    }

    // ───────── CBT ─────────
    match /cbtSubjects/{id} {
      allow read: if isAdmin() || ownsExisting();
      allow write: if isAdmin();
    }

    match /cbtExams/{id} {
      allow read: if true;
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && teacherIdUnchanged());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /cbtQuestions/{id} {
      allow read: if true;
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && teacherIdUnchanged());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /cbtResults/{id} {
      allow read: if true;
      // Only a signed-in student can submit, and only for their own record
      allow create: if isAdmin()
                    || (request.resource.data.studentId is string
                        && request.resource.data.examId is string
                        && ownsStudent(request.resource.data.studentId));
      allow update: if isAdmin();
      allow delete: if isAdmin() || ownsExisting();
    }

    // Everything else is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
