rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── helpers ─────────
    function signedIn() { return request.auth != null; }

    // Admin = a signed-in user who has a doc in /admins/{their uid} (created by hand in the Console)
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Teacher = a signed-in user who has a doc in /teachers/{their uid} (created by the admin portal)
    function isTeacher() {
      return signedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // teacher owns the existing doc / the doc being created
    function ownsExisting() { return isTeacher() && resource.data.teacherId == request.auth.uid; }
    function ownsNew()      { return isTeacher() && request.resource.data.teacherId == request.auth.uid; }
    function teacherIdUnchanged() { return request.resource.data.teacherId == resource.data.teacherId; }

    // ───────── admin / teacher identity ─────────
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;            // managed only from the Firebase Console
    }

    match /teachers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ───────── public website ─────────
    match /announcements/{id} {
      allow read: if true;                    // shown on index.html and teacher dashboard
      allow write: if isAdmin();
    }

    match /feeSettings/{id} {
      allow read: if true;                    // student portal shows fees
      allow write: if isAdmin();
    }

    // Admission form (register.html): anyone can submit, only admin can see or change
    match /applications/{id} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.keys().size() < 60;
      allow read, update, delete: if isAdmin();
    }

    // ───────── students (login is done in the browser, not Firebase Auth) ─────────
    match /students/{id} {
      allow read: if true;                    // needed for reg-number lookup, class lists and the home page count
      allow create, delete: if isAdmin();
      // CBT hall may only bump the streak/badge fields on a student's own record
      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['totalExams', 'badges']);
    }

    // Report-card results: students only ever see published ones
    match /results/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow write: if isAdmin();
    }

    // Fee payments (written by the student portal after Paystack succeeds)
    match /payments/{id} {
      allow read: if true;                    // student portal lists its own by studentId
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.reference is string
                    && request.resource.data.amount is number;
      allow update, delete: if isAdmin();
    }

    // ───────── CBT ─────────
    match /cbtSubjects/{id} {
      allow read: if isAdmin() || ownsExisting();
      allow write: if isAdmin();
    }

    match /cbtExams/{id} {
      allow read: if true;                    // students pick exams by class
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && teacherIdUnchanged());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /cbtQuestions/{id} {
      allow read: if true;                    // the exam is marked in the browser
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && teacherIdUnchanged());
      allow delete: if isAdmin() || ownsExisting();
    }

    match /cbtResults/{id} {
      allow read: if true;                    // students see their history, teachers see their class
      allow create: if request.resource.data.studentId is string
                    && request.resource.data.examId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() || ownsExisting();
    }

    // Everything else (including the old cbtChat collection) is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
